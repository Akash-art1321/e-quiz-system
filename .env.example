# QuizNest Environment Configuration
NODE_ENV=development
PORT=3000

# Secure Session Secret (Generate a 64+ char random hex string for production)
SESSION_SECRET=change_this_to_a_secure_random_secret_in_production_minimum_32_characters

# Default Admin Seed Credentials (used on initial seed if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@QuizNest2026!

# Database file location
DB_PATH=./data/quiznest.db

# Security & Cookie Settings
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=24
